# Test configuration for the ALB module.
# This file controls test behavior settings.

# Enable idempotency testing: a plan after apply must produce zero changes.
TERRATEST_IDEMPOTENCY=true

# Go test timeout -- ALB provisioning includes VPC + subnets + security group + load
# balancer + target group; allow 30 minutes to accommodate AWS control-plane latency.
GO_TEST_TIMEOUT=30m
