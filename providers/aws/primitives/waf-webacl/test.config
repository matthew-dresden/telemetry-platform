# Test configuration for this module
# This file controls test behavior settings

# Set to false to disable idempotency testing
TERRATEST_IDEMPOTENCY=true

# Go test timeout. The basic suite stands up several real CLOUDFRONT-scope WAFv2 web
# ACLs sequentially (create with managed rule groups + rate-based rule + logging
# config, then disassociate + delete). WAFv2 web ACL create/delete is subject to
# multi-minute eventual-consistency, and that latency varies with qa-account load, so
# the suite's wall-clock time fluctuates well above the 20m default. Set to 45m (the
# existing repo tier for slow primitives such as vpc-endpoint / kinesis-firehose /
# glue-catalog-database) to absorb that variance without false timeout failures.
GO_TEST_TIMEOUT=45m

# Add other test configuration settings below
